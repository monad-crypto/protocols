{
  "name": "Chord",
  "description": "Chord is a DEX aggregator that finds the best swap route across Monad DEXs, splits an order across venues when that pays more, and settles it in one non-custodial transaction. Public REST API and a hosted MCP server for AI agents. Also live on Base, BNB Chain, Avalanche, Arbitrum, Robinhood Chain and Arc.",
  "live": true,
  "categories": [
    "DeFi::DEX Aggregator",
    "AI::Infrastructure"
  ],
  "addresses": {
    // Core contracts (UUPS proxies; the same three addresses on Avalanche, BNB Chain, Base, Arbitrum, Robinhood Chain and Arc)
